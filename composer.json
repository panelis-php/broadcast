{
    "name": "panelis-php/broadcast",
    "description": "Broadcast notifications (database & mail) to users by role for Panelis.",
    "keywords": [
        "panelis"
    ],
    "authors": [
        {
            "name": "Yugo",
            "email": "dedy.yugo.purwanto@gmail.com"
        }
    ],
    "license": "MIT",
    "require": {
        "filament/filament": "^5.0",
        "illuminate/support": "^13.0",
        "lorisleiva/laravel-actions": "^2.10",
        "panelis-php/user": "^1.5"
    },
    "require-dev": {
        "laravel/pint": "^1.30"
    },
    "autoload": {
        "psr-4": {
            "Panelis\\Broadcast\\": "src/",
            "Panelis\\Broadcast\\Database\\Factories\\": "database/factories/",
            "Panelis\\Broadcast\\Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Panelis\\Broadcast\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Panelis\\Broadcast\\Providers\\BroadcastServiceProvider"
            ]
        },
        "panelis": {
            "plugins": [
                "Panelis\\Broadcast\\Plugins\\BroadcastPlugin"
            ],
            "permissions": {
                "broadcast": "Panelis\\Broadcast\\Panel\\Resources\\BroadcastResource\\Enums\\BroadcastPermission"
            }
        }
    }
}
